# All variables are optional; defaults shown. The app does not read this file: export the values
# in your shell (see RUN.md step 2). No API key or credential exists for Kivi. Do not commit .env.
PYTHONPATH=src
KIVI_DATABASE_PATH=kivi.db
KIVI_OLLAMA_URL=http://127.0.0.1:11434
# Primary review path uses the model the checked-in results were produced with.
KIVI_EXTRACTION_MODEL=qwen2.5:7b-instruct
KIVI_EMBEDDING_MODEL=nomic-embed-text:latest
KIVI_REVIEW_URL=http://127.0.0.1:8000
KIVI_RANDOM_SEED=7
